{
  "name": "belkina-admin",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate": "npx graphql-codegen --config src/shared/graphql/codegen.ts",
    "seed": "tsx seed/scripts/index.ts",
    "check-types": "tsc --noEmit",
    "migrate:create": "npm run payload migrate:create",
    "migrate:up": "npm run payload migrate",
    "migrate:status": "npm run payload migrate:status",
    "worker": "tsx scripts/worker.ts",
    "ci": "payload migrate && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@payloadcms/db-postgres": "3.68.2",
    "@payloadcms/next": "3.68.2",
    "@payloadcms/payload-cloud": "3.68.2",
    "@payloadcms/richtext-lexical": "3.68.2",
    "@payloadcms/ui": "3.68.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/postcss": "^4.1.10",
    "@tanstack/react-query": "^5.81.5",
    "@types/axios": "^0.14.4",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "cross-env": "^7.0.3",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "graphql-type-json": "^0.3.2",
    "ioredis": "^5.6.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.513.0",
    "next": "^15.4.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.5",
    "ohash": "^2.0.11",
    "payload": "3.68.2",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.1",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.58.1",
    "react-yandex-metrika": "^2.6.0",
    "redis": "^5.6.0",
    "sass": "^1.89.1",
    "sharp": "0.32.6",
    "slugify": "^1.6.6",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.1.0",
    "@types/react-big-calendar": "^1.16.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.4.8",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}